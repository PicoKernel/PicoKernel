<?xml version="1.0" encoding="UTF-8"?>
<doxygenlayout version="2.0">
  <!-- PicoKernel Doxygen Layout -->
  <!-- ============================================================ -->
  <!-- Top navigation tabs                                          -->
  <!-- ============================================================ -->
  <navindex>
    <!-- Main wiki landing page -->
    <tab type="mainpage" visible="yes" title="Home"/>

    <!-- All @page / @subpage wiki pages -->
    <tab type="pages" visible="yes" title="Wiki"/>

    <!-- API groups (@defgroup) — kernel, drivers, modules, interface -->
    <tab type="topics" visible="yes" title="Subsystems"/>

    <!-- Data structures — structs used in the kernel -->
    <tab type="structs" visible="yes" title="Data Structures">
      <tab type="structlist" visible="yes" title=""/>
      <tab type="structindex" visible="$ALPHABETICAL_INDEX" title=""/>
    </tab>

    <!-- Source files -->
    <tab type="files" visible="yes" title="Files">
      <tab type="filelist" visible="yes" title=""/>
      <tab type="globals" visible="yes" title="Globals"/>
    </tab>

    <!-- Hidden — not applicable to a C project -->
    <tab type="modules"     visible="no" title=""/>
    <tab type="namespaces"  visible="no" title=""/>
    <tab type="concepts"    visible="no" title=""/>
    <tab type="interfaces"  visible="no" title=""/>
    <tab type="classes"     visible="no" title=""/>
    <tab type="exceptions"  visible="no" title=""/>
    <tab type="examples"    visible="no" title=""/>
  </navindex>

  <!-- ============================================================ -->
  <!-- Layout for a struct page                                     -->
  <!-- ============================================================ -->
  <class>
    <briefdescription visible="yes"/>
    <memberdecl>
      <publictypes visible="yes" title=""/>
      <publicmethods visible="yes" title=""/>
      <publicattributes visible="yes" title="Member Fields"/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
    <memberdef>
      <typedefs visible="yes" title=""/>
      <functions visible="yes" title=""/>
      <variables visible="yes" title=""/>
    </memberdef>
    <authorsection visible="yes"/>
  </class>

  <!-- ============================================================ -->
  <!-- Layout for a file page                                       -->
  <!-- ============================================================ -->
  <file>
    <briefdescription visible="yes"/>
    <includes visible="$SHOW_INCLUDE_FILES"/>
    <includegraph visible="yes"/>
    <includedbygraph visible="yes"/>
    <sourcelink visible="yes"/>
    <memberdecl>
      <structs visible="yes" title=""/>
      <defines visible="yes" title="Macros"/>
      <typedefs visible="yes" title="Types"/>
      <enums visible="yes" title="Enumerations"/>
      <functions visible="yes" title="Functions"/>
      <variables visible="yes" title="Variables"/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
    <memberdef>
      <defines visible="yes" title="Macro Definitions"/>
      <typedefs visible="yes" title="Type Definitions"/>
      <enums visible="yes" title="Enumerations"/>
      <functions visible="yes" title="Function Documentation"/>
      <variables visible="yes" title="Variable Documentation"/>
    </memberdef>
    <authorsection/>
  </file>

  <!-- ============================================================ -->
  <!-- Layout for a group (@defgroup) page                         -->
  <!-- ============================================================ -->
  <group>
    <briefdescription visible="yes"/>
    <groupgraph visible="yes"/>
    <memberdecl>
      <nestedgroups visible="yes" title="Subsystems"/>
      <files visible="yes" title="Source Files"/>
      <structs visible="yes" title="Data Structures"/>
      <defines visible="yes" title="Macros"/>
      <typedefs visible="yes" title="Types"/>
      <enums visible="yes" title="Enumerations"/>
      <functions visible="yes" title="Functions"/>
      <variables visible="yes" title="Variables"/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
    <memberdef>
      <pagedocs/>
      <defines visible="yes" title="Macro Definitions"/>
      <typedefs visible="yes" title="Type Definitions"/>
      <enums visible="yes" title="Enumerations"/>
      <functions visible="yes" title="Function Documentation"/>
      <variables visible="yes" title="Variable Documentation"/>
    </memberdef>
    <authorsection visible="yes"/>
  </group>

  <!-- ============================================================ -->
  <!-- Layout for a directory page                                  -->
  <!-- ============================================================ -->
  <directory>
    <briefdescription visible="yes"/>
    <directorygraph visible="yes"/>
    <memberdecl>
      <dirs visible="yes"/>
      <files visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
  </directory>

  <!-- Namespace/concept/module pages — unused in C, kept minimal -->
  <namespace>
    <briefdescription visible="yes"/>
    <memberdecl>
      <classes visible="yes" title=""/>
      <typedefs visible="yes" title=""/>
      <enums visible="yes" title=""/>
      <functions visible="yes" title=""/>
      <variables visible="yes" title=""/>
      <membergroups visible="yes"/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
    <memberdef>
      <typedefs visible="yes" title=""/>
      <enums visible="yes" title=""/>
      <functions visible="yes" title=""/>
      <variables visible="yes" title=""/>
    </memberdef>
    <authorsection visible="yes"/>
  </namespace>

  <concept>
    <briefdescription visible="yes"/>
    <detaileddescription visible="yes" title=""/>
    <authorsection visible="yes"/>
  </concept>

  <module>
    <briefdescription visible="yes"/>
    <memberdecl>
      <classes visible="yes" title=""/>
      <enums visible="yes" title=""/>
      <typedefs visible="yes" title=""/>
      <functions visible="yes" title=""/>
      <variables visible="yes" title=""/>
      <membergroups visible="yes" title=""/>
    </memberdecl>
    <detaileddescription visible="yes" title=""/>
  </module>

</doxygenlayout>
