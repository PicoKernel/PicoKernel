# Embedded C11. Based on Linux kernel style with project-specific adjustments.
#
# Apply in-place to all source files:
#   clang-format -i $(find src -name '*.c' -o -name '*.h')
#
# Check without modifying (used by pre-commit):
#   clang-format --dry-run --Werror <file>

---
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 0

# Prevents string literals from being split across lines.
# Without this, clang-format would break a long panic message:
#
#   panic("kernel: memory: canary corrupted at block %p, expected 0xDEADFACE\n", blk);
#
# into:
#
#   panic("kernel: memory: canary corrupted at block "
#         "%p, expected 0xDEADFACE\n", blk);
#
# The broken form defeats grep and is harder to read in serial output.
# 1000 makes breaking a string literal extremely expensive — clang-format
# will reflow other surrounding code first to avoid it.
PenaltyBreakString: 1000000

# Never collapse a function body onto a single line, even for trivial accessors.
# Keeps diffs one-line-per-change and makes debugger breakpoints unambiguous.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# When a function call or definition doesn't fit on one line, put each
# argument / parameter on its own line — no mixed "some on first line, rest
# wrapped" layout. Makes multi-argument kernel API calls easier to read.
BinPackArguments: true
BinPackParameters: true

# Sort and regroup #includes: system headers (<...>) first, then project ("...").
SortIncludes: false
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: "^<"
    Priority: 1
  - Regex: '^"'
    Priority: 2

# Linux brace style: opening brace on same line for control flow and structs,
# new line before opening brace for function definitions.
BreakBeforeBraces: Linux

# Add a space before ( in control-flow keywords only:
#   if (condition)   for (...)   while (...)
# No space before function-call parens:
#   kalloc(size)   kfree(ptr)
SpaceBeforeParens: ControlStatements

# Pointer declarator: int *ptr  not  int* ptr.
# Consistent with Linux kernel style and pico-sdk conventions.
PointerAlignment: Right

# Align consecutive #define values in a block for readability:
#   #define HEAP_SIZE     4096
#   #define CANARY_VALUE  0xDEADFACEU
AlignConsecutiveMacros: Consecutive

# Do NOT reflow comment text. Preserves:
#   - Doxygen @param / @return tables
#   - ASCII architecture diagrams in @verbatim blocks
#   - Long SPDX-FileCopyrightText lines
#   - Manually wrapped printf format strings in comments
ReflowComments: false
